# Kopieer naar .env en vul in. .env staat in .gitignore.
# In de cloud (GitHub Actions) komt dit uit de repo-secrets; de workflow
# schrijft ze zelf naar .env. Dit bestand is voor lokaal draaien en testen.

# --- Supabase -------------------------------------------------------------
# Project Settings > API. De service_role key omzeilt RLS — die hoort alleen
# in .env en in de GitHub-secrets, nooit in de PWA (die krijgt de anon key).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Hoofdmodel voor de brief (oordelen, concepten in Remco's toon).
ASSISTANT_MODEL=claude-opus-5
# Goedkoper model voor het parsen van opdrachten uit de app.
ASSISTANT_MODEL_COMMANDS=claude-sonnet-5
# low | medium | high | xhigh | max — hoger = grondiger en duurder
ASSISTANT_EFFORT=medium

# --- Google (Gmail + Agenda) ---------------------------------------------
# Paden relatief aan de projectroot. Vullen via: python -m agent.google_auth
GOOGLE_CREDENTIALS_FILE=.secrets/google_client.json
GOOGLE_TOKEN_FILE=.secrets/google_token.json

# --- To-do ----------------------------------------------------------------
# TODO_PROVIDER: "todoist" | "microsoft" | "none"
TODO_PROVIDER=todoist
# Todoist > Instellingen > Integraties > Developer > API token
TODOIST_TOKEN=

# --- Gedrag ---------------------------------------------------------------
# Hoeveel uur terug de mail-collector kijkt. 36 vangt een gemiste run op.
LOOKBACK_HOURS=36
# Maximaal aantal mails per run.
MAX_EMAILS=60
# true = alles verzamelen en nadenken, niets wegschrijven. Handig bij testen.
DRY_RUN=false

# --- Pushmeldingen ----------------------------------------------------------
# Private helft van het VAPID-sleutelpaar; de publieke helft staat in pwa/app.js.
# Leeg = geen pushmeldingen, verder werkt alles.
VAPID_PRIVATE_KEY=

# --- Picnic -----------------------------------------------------------------
# Optioneel: sessiesleutel als env-variabele. Normaal leeg laten — de agent
# leest hem uit .secrets/picnic_token (vullen via: python -m agent.picnic_login).
PICNIC_AUTH_TOKEN=
